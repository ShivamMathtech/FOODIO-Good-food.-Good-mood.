# Copy to .env. No database server or API keys required.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/foodio.sqlite
# Comma-separated exact browser origins. Add your HTTPS origin before deployment.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Enables the public, local-only sample accounts listed in README.
DEMO_MODE=true
# Set false and create an admin before exposing the app publicly.
