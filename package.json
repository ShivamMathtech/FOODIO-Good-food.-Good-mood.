{
  "name": "foodio-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FOODIO food ordering storefront and operations dashboard with persistent SQLite storage",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ui",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:ui": "vitest run",
    "format": "prettier --write client server scripts tests *.mjs *.json *.md docs/*.md"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
